# syntax=docker/dockerfile:1

FROM --platform=$BUILDPLATFORM debian@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a AS ffmpeg-rpi-builder

ARG TARGETARCH

RUN test "${TARGETARCH}" = "arm64" \
    && dpkg --add-architecture arm64 \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       build-essential \
       ca-certificates \
       gcc-aarch64-linux-gnu \
       libc6-dev-arm64-cross \
       libdrm-dev:arm64 \
       libudev-dev:arm64 \
       patch \
       pkg-config \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ADD --checksum=sha256:f864a7d595b7d7ad50e2600c5002efa824e939cac941ebde487bf326f80f533a \
  https://github.com/RPi-Distro/ffmpeg/archive/2fe08f3bd52c6e795df8353d29deb89596b5099d.tar.gz \
  /tmp/ffmpeg-rpi.tar.gz
COPY experiments/ffmpeg/build.sh /usr/local/bin/build-firefox-ffmpeg
RUN chmod 0755 /usr/local/bin/build-firefox-ffmpeg \
    && /usr/local/bin/build-firefox-ffmpeg

FROM debian@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a

ARG TARGETARCH

RUN test "${TARGETARCH}" = "arm64"

ENV DEBIAN_FRONTEND=noninteractive

RUN printf '#!/bin/sh\nexit 101\n' >/usr/sbin/policy-rc.d \
    && chmod 0755 /usr/sbin/policy-rc.d \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       adwaita-icon-theme \
       alsa-utils \
       bash \
       ca-certificates \
       dbus \
       desktop-file-utils \
       fonts-dejavu-core \
       fonts-liberation \
       fonts-noto-color-emoji \
       fonts-noto-core \
       fonts-roboto \
       ffmpeg \
       firefox-esr \
       foot \
       fuzzel \
       glmark2-wayland \
       gvfs \
       gvfs-backends \
       iproute2 \
       less \
       libgl1-mesa-dri \
       libvulkan1 \
       mate-polkit \
       mesa-utils \
       mesa-vulkan-drivers \
       mousepad \
       mpv \
       nano \
       network-manager-gnome \
       pavucontrol \
       procps \
       pulseaudio-utils \
       qt6-wayland \
       ristretto \
       shared-mime-info \
       thunar \
       tumbler \
       vulkan-tools \
       waybar \
       wayland-utils \
       wl-clipboard \
       xdg-user-dirs \
       xdg-utils \
       xfce4-taskmanager \
    && rm -f \
       /usr/share/applications/firefox-esr.desktop \
       /usr/share/applications/foot-server.desktop \
       /usr/share/applications/footclient.desktop \
    && rm -f /usr/sbin/policy-rc.d \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && dpkg-query -W -f='${binary:Package}\t${Version}\n' | sort >/etc/rocknix-xfce-packages.tsv

COPY rootfs-overlay/ /
COPY --from=ffmpeg-rpi-builder /opt/ffmpeg-rpi-7.1.5/ /opt/ffmpeg-rpi-7.1.5/
# Distribute the exact source (including the RPi patch) and build/adjustment
# script beside our privately rebuilt LGPL libraries, not only an upstream URL.
COPY --from=ffmpeg-rpi-builder /tmp/ffmpeg-rpi.tar.gz /opt/ffmpeg-rpi-7.1.5/share/source/ffmpeg-rpi.tar.gz
COPY --from=ffmpeg-rpi-builder /usr/local/bin/build-firefox-ffmpeg /opt/ffmpeg-rpi-7.1.5/share/source/build.sh

RUN chmod 0755 \
      /usr/local/bin/rocknix-version \
      /usr/local/bin/rocknix-return \
      /usr/local/bin/rocknix-keyboard-toggle \
      /usr/local/bin/rocknix-firefox \
      /usr/local/bin/rocknix-sway-session \
    && mkdir -p \
      /home/rocknix-default/Desktop \
      /home/rocknix-default/.config \
      /run \
      /storage/Desktop \
      /storage/Steam \
      /storage/backup \
      /storage/games-external \
      /storage/games-internal \
      /storage/roms \
      /storage/scripts \
    && cp /usr/share/applications/rocknix-return.desktop /home/rocknix-default/Desktop/ \
    && cp /usr/share/applications/rocknix-keyboard.desktop /home/rocknix-default/Desktop/ \
    && cp /usr/share/applications/rocknix-about.desktop /home/rocknix-default/Desktop/ \
    && chmod 0755 /home/rocknix-default/Desktop/*.desktop \
    && chmod 1777 /tmp \
    && rm -f /etc/machine-id
