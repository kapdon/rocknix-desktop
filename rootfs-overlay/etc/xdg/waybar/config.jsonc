{
  "layer": "top",
  "position": "bottom",
  "height": 64,
  "spacing": 0,
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,
  "modules-left": ["custom/apps", "custom/browser"],
  "modules-right": ["network", "pulseaudio", "battery", "clock", "custom/keyboard", "custom/return"],
  "custom/apps": {
    "format": "Apps",
    "tooltip-format": "Open apps • D-pad to move • A to launch • B to close",
    "on-click": "fuzzel"
  },
  "custom/browser": {
    "format": "Firefox",
    "tooltip-format": "Open Firefox ESR",
    "on-click": "/usr/local/bin/rocknix-firefox"
  },
  "network": {
    "interval": 5,
    "format-wifi": "Wi-Fi {signalStrength}%",
    "format-ethernet": "Network",
    "format-disconnected": "Offline",
    "tooltip-format": "{ifname}: {ipaddr}"
  },
  "pulseaudio": {
    "format": "Volume {volume}%",
    "format-muted": "Muted",
    "on-click": "pavucontrol"
  },
  "battery": {
    "interval": 15,
    "format": "{capacity}%",
    "format-charging": "Charging {capacity}%",
    "states": {
      "warning": 25,
      "critical": 10
    }
  },
  "clock": {
    "interval": 1,
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A, %B %d}"
  },
  "custom/keyboard": {
    "format": "Keyboard",
    "tooltip-format": "Show or hide the on-screen keyboard • L3",
    "on-click": "/usr/local/bin/rocknix-keyboard-toggle"
  },
  "custom/return": {
    "format": "Return to Gaming",
    "tooltip-format": "Close Desktop Mode and restore EmulationStation",
    "on-click": "/usr/local/bin/rocknix-return"
  }
}
