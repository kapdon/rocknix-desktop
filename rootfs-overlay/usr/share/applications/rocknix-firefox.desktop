[Desktop Entry]
Type=Application
Version=1.0
Name=Firefox ESR
GenericName=Web Browser
Comment=Browse the web with native Wayland rendering
Exec=/usr/local/bin/rocknix-firefox %u
Icon=firefox-esr
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
