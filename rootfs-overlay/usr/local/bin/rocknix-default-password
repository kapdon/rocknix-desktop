#!/usr/bin/python3
"""Initialize an unconfigured container account; never reset an existing hash."""
from pathlib import Path
import os
import subprocess


def initialize(shadow, run=subprocess.run):
    rows = [line.split(':') for line in shadow.splitlines() if line.startswith('rocknix:')]
    if len(rows) != 1:
        raise RuntimeError('Expected exactly one rocknix account')
    if rows[0][1] in ('', '!', '!!', '*'):
        run(['/usr/sbin/chpasswd'], input='rocknix:rocknix\n', text=True, check=True)
        return True
    return False


if __name__ == '__main__':
    if os.geteuid() != 0:
        raise RuntimeError('Container root required')
    # Also used during image construction; never execute on the native host.
    initialize(Path('/etc/shadow').read_text())
