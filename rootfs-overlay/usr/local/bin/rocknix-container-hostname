#!/usr/bin/python3
"""Give the persistent guest hostname a local alias without replacing hosts."""
from pathlib import Path
import os
import re


def repair(root):
    root = Path(root)
    hostname = root / 'etc/hostname'
    hosts = root / 'etc/hosts'
    if hostname.is_symlink() or hosts.is_symlink():
        raise RuntimeError('refusing symlinked guest hostname configuration')
    name = hostname.read_text().strip()
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9.-]{0,252}', name):
        raise RuntimeError('invalid guest hostname')
    data = hosts.read_text()
    for line in data.splitlines():
        if name in line.split('#', 1)[0].split()[1:]:
            return False
    with hosts.open('a') as stream:
        stream.write(('' if data.endswith('\n') else '\n') + '127.0.1.1 ' + name + '\n')
    return True


if __name__ == '__main__':
    if os.geteuid() != 0:
        raise RuntimeError('container root required')
    for kind in ('uid_map', 'gid_map'):
        if Path('/proc/self/' + kind).read_text().split() != ['0', '200000', '65536']:
            raise RuntimeError('refusing to modify native host hostname configuration')
    repair(Path('/'))
