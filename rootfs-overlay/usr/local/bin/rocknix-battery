#!/bin/sh

BATTERY=/sys/class/power_supply/battery

if [ ! -r "${BATTERY}/capacity" ]; then
  printf '%s\n' '<icon>battery-missing-symbolic</icon><txt> --</txt><tool>Battery status unavailable</tool>'
  exit 0
fi

capacity=$(cat "${BATTERY}/capacity" 2>/dev/null || printf '0')
status=$(cat "${BATTERY}/status" 2>/dev/null || printf 'Unknown')

case "${capacity}" in
  ''|*[!0-9]*) capacity=0 ;;
esac

if [ "${capacity}" -gt 100 ]; then
  capacity=100
fi

level=$(( (capacity + 5) / 10 * 10 ))
if [ "${level}" -gt 100 ]; then
  level=100
fi

case "${status}" in
  Charging)
    icon="battery-level-${level}-charging-symbolic"
    ;;
  Full)
    icon=battery-level-100-charged-symbolic
    ;;
  *)
    icon="battery-level-${level}-symbolic"
    ;;
esac

printf '<icon>%s</icon><txt> %s%%</txt><tool>RP6 battery: %s%% (%s)</tool>\n' \
  "${icon}" "${capacity}" "${capacity}" "${status}"
