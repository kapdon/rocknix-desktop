#!/bin/sh

set -eu

if [ "${ROCKNIX_BWRAP:-0}" = 1 ]; then
  exec timeout 2 /bin/sh -c 'printf "keyboard\n" >/run/rocknix-xfce/host-control'
fi

PID_FILE=/run/rocknix-xfce/wvkbd.pid
VISIBLE_MARKER=/run/rocknix-xfce/keyboard-visible

[ -r "${PID_FILE}" ] || exit 1
pid=$(cat "${PID_FILE}")
case "${pid}" in
  ''|*[!0-9]*) exit 1 ;;
esac
kill -0 "${pid}" 2>/dev/null || exit 1
# BusyBox kill on ROCKNIX does not accept the RTMIN name. Linux assigns
# SIGRTMIN signal 34 on this architecture, which is wvkbd's toggle signal.
kill -34 "${pid}"
if [ -e "${VISIBLE_MARKER}" ]; then
  rm -f "${VISIBLE_MARKER}"
else
  : >"${VISIBLE_MARKER}"
fi
