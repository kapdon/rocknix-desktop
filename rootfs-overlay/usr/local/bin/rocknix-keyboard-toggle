#!/usr/bin/python3
"""Toggle Onboard in the current desktop session, starting it when necessary."""
import fcntl
import os
import subprocess
import time

import dbus

runtime = os.environ.get('XDG_RUNTIME_DIR', '/tmp')
with open(os.path.join(runtime, 'rocknix-keyboard-toggle.lock'), 'w') as lock:
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        raise SystemExit(0)
    bus = dbus.SessionBus()
    name = 'org.onboard.Onboard'
    running = bus.name_has_owner(name)
    if not running:
        subprocess.Popen(['onboard'], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        for _ in range(100):
            if bus.name_has_owner(name):
                break
            time.sleep(0.05)
        else:
            raise SystemExit('Onboard did not start within five seconds')
    keyboard = dbus.Interface(bus.get_object(name, '/org/onboard/Onboard/Keyboard'),
                              'org.onboard.Onboard.Keyboard')
    if running:
        keyboard.ToggleVisible()
    else:
        keyboard.Show()
