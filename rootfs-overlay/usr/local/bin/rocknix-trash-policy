#!/usr/bin/python3
"""Guest-only fstab hints; never pin packages or modify native ROCKNIX."""
import argparse
import fcntl
import os
from pathlib import Path
import stat
import subprocess
import tempfile

START = '# BEGIN ROCKNIX DESKTOP TRASH\n'
END = '# END ROCKNIX DESKTOP TRASH\n'
SHARES = tuple('/storage/' + name for name in
               ('Desktop', 'Steam', 'backup', 'games-external', 'games-internal'))
EXPECTED = {name: version for names, version in (
    (('libglib2.0-0t64', 'libglib2.0-bin'), '2.84.4-3~deb13u5+rocknix1'),
    (('gvfs', 'gvfs-daemons', 'gvfs-libs'), '1.57.2-2+deb13u1+rocknix1'),
) for name in names}


def mapped():
    return all(Path('/proc/self/' + name).read_text().split() ==
               ['0', '200000', '65536'] for name in ('uid_map', 'gid_map'))


def supported():
    for name, version in EXPECTED.items():
        result = subprocess.run(['dpkg-query', '-W', '-f=${Status} ${Version}', name],
                                capture_output=True, text=True, timeout=10)
        if result.returncode or result.stdout != 'install ok installed ' + version:
            return False
    return True


def render(original, mounts, enable):
    """Preserve unrelated/user fstab records; own only one marked block."""
    if original.count(START) != original.count(END) or original.count(START) > 1:
        raise RuntimeError('malformed managed Trash block; refusing fstab rewrite')
    if START in original:
        before, rest = original.split(START)
        body, after = rest.split(END)
        owned = {f'none {path} none {option} 0 0' for path in SHARES
                 for hint in ('x-gvfs-trash', 'x-gvfs-notrash')
                 for option in (hint, 'noauto,' + hint)}
        if any(line not in owned for line in body.splitlines()):
            raise RuntimeError('unexpected content inside managed Trash block')
        original = before + after
    # A user-supplied record (including an explicit opt-out) always wins.
    configured = {fields[1] for line in original.splitlines()
                  if not line.lstrip().startswith('#') and len(fields := line.split()) >= 2}
    option = 'x-gvfs-trash' if enable else 'x-gvfs-notrash'
    # Metadata for existing host binds, not mount requests. Maintenance boots
    # deliberately have no shared mounts; automatic mount units would fail and
    # send systemd to emergency.target before the updater could run.
    records = [f'none {path} none noauto,{option} 0 0\n'
               for path in SHARES if path in mounts and path not in configured]
    if not records:
        return original
    return original + ('' if not original or original.endswith('\n') else '\n') + START + ''.join(records) + END


def replace_fstab(path, contents):
    info = path.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        raise RuntimeError('fstab must be a root-owned non-writable regular file')
    fd, name = tempfile.mkstemp(prefix='.rocknix-trash-', dir=path.parent)
    temporary = Path(name)
    try:
        with os.fdopen(fd, 'w') as stream:
            stream.write(contents)
            os.fchmod(stream.fileno(), stat.S_IMODE(info.st_mode))
            os.fchown(stream.fileno(), info.st_uid, info.st_gid)
            stream.flush()
            os.fsync(stream.fileno())
        temporary.replace(path)
        parent = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(parent)
        finally:
            os.close(parent)
    finally:
        temporary.unlink(missing_ok=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--disable', action='store_true')
    parser.add_argument('--apt', action='store_true', help='No-op outside the mapped runtime during image builds')
    args = parser.parse_args()
    if not mapped():
        if args.apt:
            return
        raise RuntimeError('refusing native/unmapped root')
    if os.geteuid() != 0:
        raise RuntimeError('requires mapped container root')
    fd = os.open('/run/rocknix-trash-policy.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        path = Path('/etc/fstab')
        if path.is_symlink():
            raise RuntimeError('refusing symlinked fstab')
        original = path.read_text()
        mounts = {line.split()[4] for line in Path('/proc/self/mountinfo').read_text().splitlines()}
        enabled = not args.disable and supported()
        updated = render(original, mounts, enabled)
        if updated != original:
            replace_fstab(path, updated)
            print('Shared-folder Trash policy: ' + ('tested packages enabled' if enabled else
                  'disabled pending compatible packages; restart file managers after package updates'))


if __name__ == '__main__':
    main()
