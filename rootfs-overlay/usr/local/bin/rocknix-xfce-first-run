#!/bin/bash

set -u

export HOME=/home/rocknix
export XDG_CONFIG_HOME="${HOME}/.config"
LOG="${HOME}/.local/share/rocknix-xfce-first-run.log"
MARKER="${XDG_CONFIG_HOME}/rocknix-xfce/configured-v1"

mkdir -p "$(dirname "${LOG}")" "$(dirname "${MARKER}")"
exec >>"${LOG}" 2>&1

printf '%s session integration start\n' "$(date -Is)"
xset s off
xset -dpms

for _ in $(seq 1 50); do
  if xfconf-query -c xsettings -p /Net/ThemeName >/dev/null 2>&1; then
    break
  fi
  sleep 0.1
done

set_xfconf() {
  local channel="$1"
  local property="$2"
  local type="$3"
  local value="$4"

  if xfconf-query -c "${channel}" -p "${property}" >/dev/null 2>&1; then
    xfconf-query -c "${channel}" -p "${property}" -s "${value}"
  else
    xfconf-query -c "${channel}" -p "${property}" -n -t "${type}" -s "${value}"
  fi
}

# Session integration also applies to homes configured by earlier releases.
# Linux KEY_F13 is XF86Tools in this XKB evdev layout (keycode 191).
set_xfconf xfce4-keyboard-shortcuts /commands/custom/XF86Tools string rocknix-keyboard-toggle
# Remove only our obsolete binding, not an unrelated user shortcut.
if [ "$(xfconf-query -c xfce4-keyboard-shortcuts -p /commands/custom/F13 2>/dev/null)" = rocknix-keyboard-toggle ]; then
  xfconf-query -c xfce4-keyboard-shortcuts -p /commands/custom/F13 -r
fi

if [ -e "${MARKER}" ]; then
  exit 0
fi

set_xfconf xsettings /Net/ThemeName string Adwaita-dark
set_xfconf xsettings /Net/IconThemeName string Adwaita
set_xfconf xsettings /Gtk/CursorThemeName string Adwaita
set_xfconf xsettings /Gtk/CursorThemeSize int 32
set_xfconf xsettings /Xft/DPI int 144
set_xfconf xfwm4 /general/use_compositing bool false
set_xfconf xfce4-desktop /desktop-icons/icon-size uint 48

if xfconf-query -c xfce4-panel -p /panels/panel-1 >/dev/null 2>&1; then
  set_xfconf xfce4-panel /panels/panel-1/size uint 52
  set_xfconf xfce4-panel /panels/panel-1/icon-size uint 36
fi

touch "${MARKER}"
printf '%s session integration complete\n' "$(date -Is)"
