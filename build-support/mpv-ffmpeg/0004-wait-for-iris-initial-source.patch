+/* A positive timeout waits only for headers after all input has been fed. */
+static int v4l2_wait_initial_source(V4L2m2mContext *s, int timeout)
+{
+    struct pollfd pfd = {
+        .fd = s->fd,
+        .events = POLLPRI | (timeout < 0 ? POLLOUT | POLLWRNORM : 0),
+    };
+    int64_t deadline = timeout > 0 ? av_gettime_relative() + timeout * 1000LL : 0;
+    int ret, wait;
+
+    while (!s->initial_source_seen) {
+        struct v4l2_event evt = { 0 };
+        wait = timeout;
+        if (deadline) {
+            int64_t remaining = deadline - av_gettime_relative();
+            if (remaining <= 0)
+                break;
+            wait = (remaining + 999) / 1000;
+        }
+        ret = poll(&pfd, 1, wait);
+        if (ret < 0) {
+            if (errno == EINTR)
+                continue;
+            return AVERROR(errno);
+        }
+        if (!ret) {
+            if (deadline)
+                break;
+            return AVERROR(EAGAIN);
+        }
+        /* A queued event can coexist with POLLERR before capture is ready. */
+        if (pfd.revents & POLLPRI) {
+            if (ioctl(s->fd, VIDIOC_DQEVENT, &evt) < 0) {
+                if (errno == EAGAIN)
+                    continue;
+                return AVERROR(errno);
+            }
+            if (evt.type == V4L2_EVENT_SOURCE_CHANGE &&
+                (evt.u.src_change.changes & V4L2_EVENT_SRC_CH_RESOLUTION)) {
+                s->initial_source_seen = 1;
+                return 0;
+            }
+            continue;
+        }
+        if (pfd.revents & (POLLERR | POLLHUP | POLLNVAL)) {
+            av_log(s->avctx, AV_LOG_ERROR, "Iris failed before initial source change\n");
+            return AVERROR(EIO);
+        }
+        if (pfd.revents & (POLLOUT | POLLWRNORM))
+            return AVERROR(EAGAIN);
+    }
+    if (s->initial_source_seen)
+        return 0;
+    av_log(s->avctx, AV_LOG_ERROR, "Timed out waiting for Iris stream headers\n");
+    return AVERROR(ETIMEDOUT);
+}
