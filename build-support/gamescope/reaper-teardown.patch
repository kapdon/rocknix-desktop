 namespace gamescope
 {
     static LogScope s_ReaperLog( "reaper" );
+
+    static volatile sig_atomic_t s_bRun = 1;
+
+    // Poll so a shutdown signal also ends a wait on a TERM-resistant primary.
+    static void WaitForPrimary( pid_t nPrimary )
+    {
+        while ( s_bRun )
+        {
+            pid_t nDead = waitpid( -1, nullptr, WNOHANG );
+            if ( nDead == nPrimary || ( nDead == -1 && errno == ECHILD ) )
+                return;
+            if ( nDead <= 0 )
+                usleep( 10000 );
+        }
+    }
+
+    static void TerminateChildren()
+    {
+        using Clock = std::chrono::steady_clock;
+        auto start = Clock::now();
+        Process::KillAllChildren( getpid(), SIGTERM );
+        for ( ;; )
+        {
+            pid_t nDead = waitpid( -1, nullptr, WNOHANG );
+            if ( nDead == -1 && errno == ECHILD )
+                return;
+            auto elapsed = Clock::now() - start;
+            if ( elapsed >= std::chrono::seconds( 3 ) )
+                Process::KillAllChildren( getpid(), SIGKILL );
+            // Do not hold Gamescope open forever on an uninterruptible child.
+            // The enclosing launch service remains the final cleanup boundary.
+            if ( elapsed >= std::chrono::seconds( 5 ) )
+                return;
+            if ( nDead <= 0 )
+                usleep( 10000 );
+        }
+    }
 
