#!/bin/bash

set -Eeuo pipefail

source /etc/profile

BASE=/storage/.local/share/rocknix-xfce
ROOTFS="${BASE}/rootfs"
HOME_SOURCE="${BASE}/home"
LOG_DIR="${BASE}/logs"
LOG="${LOG_DIR}/session.log"
RUNTIME_DIR=/run/rocknix-xfce
SESSION_STATE=/run/rocknix-xfce-session-state
CONTROL_FIFO="${RUNTIME_DIR}/control"
SWAY_STYLE_MARKER="${RUNTIME_DIR}/sway-style-owned"
DESKTOP_WORKSPACE='98:Desktop'
WVKBD_PID=""
BINDING_INSTALLED=0

discover_sway_environment() {
  local candidate

  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/var/run/0-runtime-dir}"

  if [ -z "${SWAYSOCK:-}" ] || [ ! -S "${SWAYSOCK}" ]; then
    unset SWAYSOCK
    for candidate in "${XDG_RUNTIME_DIR}"/sway-ipc.*.sock; do
      if [ -S "${candidate}" ]; then
        export SWAYSOCK="${candidate}"
        break
      fi
    done
  fi

  if [ -z "${WAYLAND_DISPLAY:-}" ] || [ ! -S "${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}" ]; then
    unset WAYLAND_DISPLAY
    for candidate in "${XDG_RUNTIME_DIR}"/wayland-*; do
      if [ -S "${candidate}" ]; then
        export WAYLAND_DISPLAY="${candidate##*/}"
        break
      fi
    done
  fi

  [ -n "${SWAYSOCK:-}" ] || { printf 'Cannot find the Sway IPC socket\n' >&2; exit 1; }
  [ -n "${WAYLAND_DISPLAY:-}" ] || { printf 'Cannot find the Wayland socket\n' >&2; exit 1; }
}

mount_rbind() {
  mount --rbind "$1" "$2"
  mount --make-rslave "$2"
}

mkdir -p "${LOG_DIR}" "${HOME_SOURCE}"
if [ -f "${LOG}" ]; then
  mv -f "${LOG}" "${LOG}.previous"
fi
: >"${LOG}"
exec > >(tee -a "${LOG}") 2>&1

printf '%s Sway Desktop Mode session starting\n' "$(date -Is)"

cleanup() {
  local rc=$?
  trap - EXIT INT TERM HUP

  if [ -f "${SWAY_STYLE_MARKER}" ] && systemctl is-active --quiet sway.service; then
    swaymsg reload >/dev/null 2>&1 || true
    rm -f "${SWAY_STYLE_MARKER}"
  fi
  if [ "${BINDING_INSTALLED}" = 1 ] && systemctl is-active --quiet sway.service; then
    swaymsg 'unbindsym XF86Tools' >/dev/null 2>&1 || true
    swaymsg 'unbindsym F13' >/dev/null 2>&1 || true
    rm -f "${RUNTIME_DIR}/bindings-owned"
  fi
  if [ -n "${WVKBD_PID}" ] && kill -0 "${WVKBD_PID}" 2>/dev/null; then
    kill -TERM "${WVKBD_PID}" 2>/dev/null || true
    # The service cgroup owns this process; do not block return on a client.
  fi
  rm -f "${RUNTIME_DIR}/wvkbd.pid" "${CONTROL_FIFO}"
  rmdir "${RUNTIME_DIR}" 2>/dev/null || true

  printf '%s Sway Desktop Mode session ended with status %s\n' "$(date -Is)" "${rc}"
  exit "${rc}"
}
trap cleanup EXIT
trap 'exit 143' TERM HUP
trap 'exit 130' INT

"${BASE}/bin/preflight"
discover_sway_environment

mkdir -p \
  "${ROOTFS}/dev" \
  "${ROOTFS}/proc" \
  "${ROOTFS}/run" \
  "${ROOTFS}/sys" \
  "${ROOTFS}/tmp" \
  "${ROOTFS}/home/rocknix"

mount_rbind /dev "${ROOTFS}/dev"
mount -t proc proc "${ROOTFS}/proc"
mount_rbind /sys "${ROOTFS}/sys"
mount_rbind /run "${ROOTFS}/run"
mount --bind /tmp "${ROOTFS}/tmp"
mount --bind "${HOME_SOURCE}" "${ROOTFS}/home/rocknix"

for shared in Desktop Steam backup games-external games-internal roms scripts; do
  if [ -d "/storage/${shared}" ]; then
    mkdir -p "${ROOTFS}/storage/${shared}"
    mount --bind "/storage/${shared}" "${ROOTFS}/storage/${shared}"
  fi
done

if [ -f /etc/resolv.conf ]; then
  touch "${ROOTFS}/etc/resolv.conf"
  mount --bind /etc/resolv.conf "${ROOTFS}/etc/resolv.conf"
fi

PRIOR_WORKSPACE=$(swaymsg -r -t get_workspaces | jq -er '.[] | select(.focused).name')
TOUCHKEYBOARD_ACTIVE=0
if systemctl is-active --quiet touchkeyboard.service; then
  TOUCHKEYBOARD_ACTIVE=1
fi
# ROCKNIX's get_setting reads optional positional parameters directly, so call
# it with nounset disabled while preserving strict mode for this script.
set +u
TOUCHKEYBOARD_SETTING=$(get_setting 'rocknix.touchscreen-keyboard.enabled' || true)
set -u
{
  printf 'workspace=%s\n' "${PRIOR_WORKSPACE}"
  printf 'touchkeyboard_active=%s\n' "${TOUCHKEYBOARD_ACTIVE}"
  printf 'touchkeyboard_setting=%s\n' "${TOUCHKEYBOARD_SETTING}"
} >"${SESSION_STATE}.new"
mv -f "${SESSION_STATE}.new" "${SESSION_STATE}"

systemctl stop essway.service
! systemctl is-active --quiet essway.service || { printf 'EmulationStation did not stop\n' >&2; exit 1; }
systemctl is-active --quiet sway.service || { printf 'Sway stopped unexpectedly\n' >&2; exit 1; }

systemctl stop touchkeyboard.service
set_setting 'rocknix.touchscreen-keyboard.enabled' '0'
pkill -x wvkbd-mobintl 2>/dev/null || true

"${BASE}/bin/configure-input"

mkdir -p "${RUNTIME_DIR}"
chmod 0700 "${RUNTIME_DIR}"
rm -f -- "${CONTROL_FIFO}"
mkfifo -m 0600 "${CONTROL_FIFO}"

/usr/bin/wvkbd-mobintl \
  -H 380 -L 380 -fg 6b6b75 -fg-sp 6b6b75 -bg 1d1d1d \
  --text ffffff --text-sp ffffff -press 000000 --press-sp 000000 \
  -fn 32 -l full,nav,special --hidden --output DSI-1 >>"${LOG}" 2>&1 &
WVKBD_PID=$!
printf '%s\n' "${WVKBD_PID}" >"${RUNTIME_DIR}/wvkbd.pid"

for _ in {1..50}; do
  kill -0 "${WVKBD_PID}" 2>/dev/null && break
  sleep 0.1
done
kill -0 "${WVKBD_PID}" 2>/dev/null || { printf 'wvkbd failed to start\n' >&2; exit 1; }

BINDING_INSTALLED=1
touch "${RUNTIME_DIR}/bindings-owned"
swaymsg -- "bindsym XF86Tools exec ${BASE}/bin/rocknix-keyboard-toggle" >/dev/null
swaymsg -- "bindsym F13 exec ${BASE}/bin/rocknix-keyboard-toggle" >/dev/null
swaymsg -- "workspace ${DESKTOP_WORKSPACE}" >/dev/null
swaymsg 'layout tabbed' >/dev/null

# Art Book Next uses a #444 selection band over #111 fields. Apply that same
# hierarchy to Sway's tab strip, then reload the device config during cleanup.
touch "${SWAY_STYLE_MARKER}"
swaymsg 'client.focused #444444 #444444 #ffffff #444444 #444444' >/dev/null
swaymsg 'client.focused_inactive #111111 #111111 #aaaaaa #111111 #111111' >/dev/null
swaymsg 'client.unfocused #111111 #111111 #777777 #111111 #111111' >/dev/null
swaymsg 'client.urgent #444444 #444444 #ffffff #444444 #444444' >/dev/null
swaymsg 'client.placeholder #000000 #000000 #777777 #000000 #000000' >/dev/null
swaymsg 'client.background #000000' >/dev/null

TZ_VALUE=$(timedatectl show -p Timezone --value 2>/dev/null || true)
TZ_VALUE=${TZ_VALUE:-UTC}
DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR}/bus}
PULSE_SERVER=${PULSE_SERVER:-unix:${XDG_RUNTIME_DIR}/pulse/native}

printf '%s Starting native Wayland desktop clients\n' "$(date -Is)"
/usr/sbin/chroot "${ROOTFS}" /usr/bin/env -i \
  HOME=/home/rocknix \
  USER=root \
  LOGNAME=root \
  SHELL=/bin/bash \
  PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
  LANG=C.UTF-8 \
  LC_ALL=C.UTF-8 \
  TZ="${TZ_VALUE}" \
  XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR}" \
  WAYLAND_DISPLAY="${WAYLAND_DISPLAY}" \
  SWAYSOCK="${SWAYSOCK}" \
  DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS}" \
  DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket \
  PULSE_SERVER="${PULSE_SERVER}" \
  XDG_SESSION_TYPE=wayland \
  XDG_CURRENT_DESKTOP=sway \
  GDK_BACKEND=wayland \
  QT_QPA_PLATFORM=wayland \
  SDL_VIDEODRIVER=wayland \
  MOZ_ENABLE_WAYLAND=1 \
  MESA_LOADER_DRIVER_OVERRIDE=msm \
  GALLIUM_DRIVER=freedreno \
  /usr/local/bin/rocknix-sway-session
