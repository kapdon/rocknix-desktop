#!/bin/bash

set -u

source /etc/profile

# ExecStopPost runs after systemd has reaped the desktop cgroup, even when
# the main process was killed before its EXIT trap finished (e.g. tee SIGPIPE).
if [ -f /run/rocknix-xfce/sway-style-owned ] && systemctl is-active --quiet sway.service; then
  swaymsg reload >/dev/null 2>&1 || true
fi
rm -f -- \
  /run/rocknix-xfce/control \
  /run/rocknix-xfce/host-control \
  /run/rocknix-xfce/keyboard-visible \
  /run/rocknix-xfce/sway-style-owned \
  /run/rocknix-xfce/waybar-config.jsonc \
  /run/rocknix-xfce/waybar-style.css \
  /run/rocknix-xfce/window-count \
  /run/rocknix-xfce/window-count.new \
  /run/rocknix-xfce/wvkbd.pid
if [ -f /run/rocknix-xfce/bindings-owned ] && systemctl is-active --quiet sway.service; then
  swaymsg 'unbindsym XF86Tools' >/dev/null 2>&1 || true
  swaymsg 'unbindsym F13' >/dev/null 2>&1 || true
  swaymsg 'unbindsym F14' >/dev/null 2>&1 || true
  swaymsg 'unbindsym F15' >/dev/null 2>&1 || true
fi
rm -f -- /run/rocknix-xfce/bindings-owned
rmdir /run/rocknix-xfce 2>/dev/null || true

STATE_FILE=/run/rocknix-xfce-input-state
SESSION_STATE=/run/rocknix-xfce-session-state
ORIGINAL_PROFILE=""
PRIOR_WORKSPACE=""
TOUCHKEYBOARD_ACTIVE=0
TOUCHKEYBOARD_SETTING=""
INPUT_STATE_PRESENT=0
SESSION_STATE_PRESENT=0
declare -a ORIGINAL_TARGETS=()

if [ -f "${STATE_FILE}" ]; then
  INPUT_STATE_PRESENT=1
  while IFS='=' read -r key value; do
    case "${key}" in
      profile) ORIGINAL_PROFILE=${value} ;;
      target) ORIGINAL_TARGETS+=("${value}") ;;
    esac
  done <"${STATE_FILE}"
fi

if [ -f "${SESSION_STATE}" ]; then
  SESSION_STATE_PRESENT=1
  while IFS='=' read -r key value; do
    case "${key}" in
      workspace) PRIOR_WORKSPACE=${value} ;;
      touchkeyboard_active) TOUCHKEYBOARD_ACTIVE=${value} ;;
      touchkeyboard_setting) TOUCHKEYBOARD_SETTING=${value} ;;
    esac
  done <"${SESSION_STATE}"
fi

if [ -r /run/rocknix-xfce/wvkbd.pid ]; then
  WVKBD_PID=$(cat /run/rocknix-xfce/wvkbd.pid)
  case "${WVKBD_PID}" in
    ''|*[!0-9]*) ;;
    *) kill -TERM "${WVKBD_PID}" 2>/dev/null || true ;;
  esac
fi

if [ "${INPUT_STATE_PRESENT}" = 1 ] && \
    [ -n "${ORIGINAL_PROFILE}" ] && [ -f "${ORIGINAL_PROFILE}" ] && \
    [ "${#ORIGINAL_TARGETS[@]}" -gt 0 ] && \
    command -v inputplumber >/dev/null 2>&1 && \
    inputplumber devices list >/dev/null 2>&1; then
  inputplumber device 0 profile load "${ORIGINAL_PROFILE}" >/dev/null 2>&1 || true
  inputplumber device 0 targets set "${ORIGINAL_TARGETS[@]}" >/dev/null 2>&1 || true
fi

if [ "${SESSION_STATE_PRESENT}" = 1 ]; then
  if [ -n "${TOUCHKEYBOARD_SETTING}" ]; then
    set_setting 'rocknix.touchscreen-keyboard.enabled' "${TOUCHKEYBOARD_SETTING}"
  else
    set_setting 'rocknix.touchscreen-keyboard.enabled' default
  fi
fi

STATE=$(systemctl is-system-running 2>/dev/null || true)
case "${STATE}" in
  stopping|offline)
    exit 0
    ;;
esac

ensure_active() {
  local unit=$1 label=$2

  # A synchronous start of sway.service from this unit's ExecStopPost can wait
  # on the very stop job running this hook. Avoid that transaction deadlock,
  # and do not enqueue a redundant job when the compositor stayed active.
  if ! systemctl is-active --quiet "${unit}"; then
    systemctl start --no-block "${unit}"
  fi
  for _ in {1..100}; do
    systemctl is-active --quiet "${unit}" && return 0
    sleep 0.1
  done
  printf '%s did not recover\n' "${label}" >&2
  return 1
}

ensure_active sway.service Sway
ensure_active essway.service EmulationStation

if [ "${SESSION_STATE_PRESENT}" = 1 ]; then
  if [ "${TOUCHKEYBOARD_ACTIVE}" = 1 ]; then
    systemctl start touchkeyboard.service
  else
    systemctl stop touchkeyboard.service
  fi
fi

if [ -n "${PRIOR_WORKSPACE}" ]; then
  swaymsg -- "workspace ${PRIOR_WORKSPACE}" >/dev/null 2>&1 || true
fi
if command -v set_kill >/dev/null 2>&1; then
  set_kill set "emulationstation" >/dev/null 2>&1 || true
fi

rm -f "${STATE_FILE}" "${SESSION_STATE}"
printf 'EmulationStation and desktop input state restored.\n'
