#!/bin/bash

set -Eeuo pipefail

source /etc/profile

BASE=/storage/.local/share/rocknix-xfce
ROOTFS="${BASE}/rootfs"
HOME_SOURCE="${BASE}/home"
LOG_DIR="${BASE}/logs"
LOG="${LOG_DIR}/session.log"
DISPLAY_NUMBER=:1
XWAYLAND_PID=""

discover_sway_environment() {
  local candidate

  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/var/run/0-runtime-dir}"

  if [ -z "${SWAYSOCK:-}" ] || [ ! -S "${SWAYSOCK}" ]; then
    unset SWAYSOCK
    for candidate in "${XDG_RUNTIME_DIR}"/sway-ipc.*.sock; do
      if [ -S "${candidate}" ]; then
        export SWAYSOCK="${candidate}"
        break
      fi
    done
  fi

  if [ -z "${WAYLAND_DISPLAY:-}" ] || [ ! -S "${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}" ]; then
    unset WAYLAND_DISPLAY
    for candidate in "${XDG_RUNTIME_DIR}"/wayland-*; do
      if [ -S "${candidate}" ]; then
        export WAYLAND_DISPLAY="${candidate##*/}"
        break
      fi
    done
  fi

  [ -n "${SWAYSOCK:-}" ] || {
    printf 'Cannot find the active Sway IPC socket\n' >&2
    exit 1
  }
  [ -n "${WAYLAND_DISPLAY:-}" ] || {
    printf 'Cannot find the active Wayland display\n' >&2
    exit 1
  }
}

mkdir -p "${LOG_DIR}" "${HOME_SOURCE}"
if [ -f "${LOG}" ]; then
  mv -f "${LOG}" "${LOG}.previous"
fi
: >"${LOG}"
exec > >(tee -a "${LOG}") 2>&1

printf '%s Desktop Mode session starting\n' "$(date -Is)"

cleanup() {
  local rc=$?
  trap - EXIT INT TERM HUP

  if [ -n "${XWAYLAND_PID}" ] && kill -0 "${XWAYLAND_PID}" 2>/dev/null; then
    kill -TERM "${XWAYLAND_PID}" 2>/dev/null || true
    wait "${XWAYLAND_PID}" 2>/dev/null || true
  fi


  rmdir /run/rocknix-xfce 2>/dev/null || true

  # ExecStopPost restores Sway/ES after the entire desktop cgroup has exited.
  # Starting Sway here can race Xorg releasing DRM during a service stop.

  printf '%s Desktop Mode session ended with status %s\n' "$(date -Is)" "${rc}"
  exit "${rc}"
}
trap cleanup EXIT
trap 'exit 143' TERM HUP
trap 'exit 130' INT

"${BASE}/bin/preflight"
discover_sway_environment

mount_rbind() {
  mount --rbind "$1" "$2"
  mount --make-rslave "$2"
}

mkdir -p \
  "${ROOTFS}/dev" \
  "${ROOTFS}/proc" \
  "${ROOTFS}/run" \
  "${ROOTFS}/sys" \
  "${ROOTFS}/tmp" \
  "${ROOTFS}/home/rocknix"

mount_rbind /dev "${ROOTFS}/dev"
mount -t proc proc "${ROOTFS}/proc"
mount_rbind /sys "${ROOTFS}/sys"
mount_rbind /run "${ROOTFS}/run"
mount --bind /tmp "${ROOTFS}/tmp"
mount --bind "${HOME_SOURCE}" "${ROOTFS}/home/rocknix"

for shared in Desktop Steam backup games-external games-internal roms scripts; do
  if [ -d "/storage/${shared}" ]; then
    mkdir -p "${ROOTFS}/storage/${shared}"
    mount --bind "/storage/${shared}" "${ROOTFS}/storage/${shared}"
  fi
done

if [ -f /etc/resolv.conf ]; then
  touch "${ROOTFS}/etc/resolv.conf"
  mount --bind /etc/resolv.conf "${ROOTFS}/etc/resolv.conf"
fi

GEOMETRY=$(swaymsg -r -t get_outputs | jq -er '.[] | select(.focused == true) | "\(.rect.width)x\(.rect.height)"' | head -n 1)
[ -n "${GEOMETRY}" ]

systemctl stop essway.service

"${BASE}/bin/configure-input"

# Direct Xorg avoids rootful Xwayland repaint corruption. Keep -noreset below:
# a reset between xrandr and XFCE left the rotated scanout buffer black.
# The persistent "shm" override remains available as a fallback.
GRAPHICS_MODE=xorg
if [ -f "${BASE}/graphics-mode" ]; then
  GRAPHICS_MODE=$(<"${BASE}/graphics-mode")
fi
case "${GRAPHICS_MODE}" in
  xorg|shm) ;;
  *) printf 'Unsupported graphics mode: %s\n' "${GRAPHICS_MODE}" >&2; exit 1 ;;
esac
printf '%s Starting display %s (%s, %s)\n' "$(date -Is)" "${DISPLAY_NUMBER}" "${GEOMETRY}" "${GRAPHICS_MODE}"
if [ "${GRAPHICS_MODE}" = xorg ]; then
  systemctl stop sway.service
  /usr/sbin/chroot "${ROOTFS}" /usr/bin/env -i \
    PATH=/usr/bin:/bin HOME=/home/rocknix \
    MESA_LOADER_DRIVER_OVERRIDE=msm GALLIUM_DRIVER=freedreno \
    /usr/bin/Xorg "${DISPLAY_NUMBER}" -noreset -nolisten tcp -ac \
      -config /etc/X11/rocknix-xfce.conf -logfile /tmp/rocknix-xorg.log \
      vt1 >>"${LOG}" 2>&1 &
else
/usr/sbin/chroot "${ROOTFS}" /usr/bin/env -i \
  PATH=/usr/bin:/bin XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR}" \
  WAYLAND_DISPLAY="${WAYLAND_DISPLAY}" \
  /usr/bin/Xwayland "${DISPLAY_NUMBER}" \
  -fullscreen \
  -geometry "${GEOMETRY}" \
  -dpi 144 \
  -shm \
  -nolisten tcp \
  -ac \
  >>"${LOG}" 2>&1 &
fi
XWAYLAND_PID=$!

for _ in {1..100}; do
  if [ -S /tmp/.X11-unix/X1 ] && kill -0 "${XWAYLAND_PID}" 2>/dev/null; then
    break
  fi
  sleep 0.1
done

[ -S /tmp/.X11-unix/X1 ] || {
  printf 'Display server did not create display %s\n' "${DISPLAY_NUMBER}" >&2
  exit 1
}
kill -0 "${XWAYLAND_PID}" 2>/dev/null || {
  printf 'Display server exited during startup\n' >&2
  exit 1
}

mkdir -p /run/rocknix-xfce
chmod 0700 /run/rocknix-xfce

if [ "${GRAPHICS_MODE}" = xorg ]; then
  /usr/sbin/chroot "${ROOTFS}" /usr/bin/env DISPLAY=:1 xrandr --output DSI-1 --rotate left
fi

TZ_VALUE=$(timedatectl show -p Timezone --value 2>/dev/null || true)
TZ_VALUE=${TZ_VALUE:-UTC}

printf '%s Starting XFCE\n' "$(date -Is)"
/usr/sbin/chroot "${ROOTFS}" /usr/bin/env -i \
  DISPLAY="${DISPLAY_NUMBER}" \
  HOME=/home/rocknix \
  USER=root \
  LOGNAME=root \
  SHELL=/bin/bash \
  PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
  LANG=C.UTF-8 \
  LC_ALL=C.UTF-8 \
  TZ="${TZ_VALUE}" \
  XDG_RUNTIME_DIR=/run/rocknix-xfce \
  DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket \
  PULSE_SERVER=unix:/run/0-runtime-dir/pulse/native \
  MESA_LOADER_DRIVER_OVERRIDE=msm \
  GALLIUM_DRIVER=freedreno \
  __GLX_VENDOR_LIBRARY_NAME=mesa \
  QT_QPA_PLATFORM=xcb \
  SDL_VIDEODRIVER=x11 \
  /usr/local/bin/rocknix-xfce-session
