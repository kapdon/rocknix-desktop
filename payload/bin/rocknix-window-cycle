#!/bin/sh
set -eu

tree=$(swaymsg -r -t get_tree) || exit 0
target=$(printf '%s' "$tree" | jq -er '
  [.. | objects | select(.type? == "workspace" and .name? == "98:Desktop")
   | .. | objects | select(.type? == "con" or .type? == "floating_con")
   | select(.shell? == "xdg_shell" or .shell? == "xwayland")
   | select(((.nodes // []) | length) == 0 and
            ((.floating_nodes // []) | length) == 0)
   | select((.id | type) == "number" and .id > 0 and (.id | floor) == .id)]
  | sort_by(.id) as $windows
  | [$windows | to_entries[] | select(.value.focused == true) | .key] as $focus
  | select(($windows | length) > 1 and ($focus | length) == 1)
  | $windows[(($focus[0] + 1) % ($windows | length))].id
') || exit 0
case "$target" in ''|*[!0-9]*|0) exit 0 ;; esac
exec swaymsg "[con_id=$target workspace=\"^98:Desktop$\"] focus"
