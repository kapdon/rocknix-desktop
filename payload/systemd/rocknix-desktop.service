[Unit]
Description=ROCKNIX Sway Desktop Mode
Documentation=file:/storage/rocknix-desktop/managed/host/README.md
BindsTo=sway.service
After=network.target sway.service
ConditionPathIsDirectory=/storage/rocknix-desktop/data/rootfs

[Service]
Type=simple
Environment=HOME=/storage
ExecStartPre=/storage/rocknix-desktop/managed/host/bin/preflight
ExecStart=/usr/bin/unshare --mount --propagation private -- /storage/rocknix-desktop/managed/host/bin/launch-sway-desktop
ExecStopPost=/storage/rocknix-desktop/managed/host/bin/restore-emulationstation
KillMode=control-group
TimeoutStopSec=45
SuccessExitStatus=143
Restart=no
StandardOutput=journal
StandardError=journal
