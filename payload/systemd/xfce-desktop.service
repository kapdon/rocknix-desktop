[Unit]
Description=ROCKNIX XFCE Desktop Mode
Documentation=file:/storage/.local/share/rocknix-xfce/README.md
Wants=sway.service
After=network.target
ConditionPathIsDirectory=/storage/.local/share/rocknix-xfce/rootfs

[Service]
Type=simple
Environment=HOME=/storage
ExecStartPre=/storage/.local/share/rocknix-xfce/bin/preflight
ExecStart=/usr/bin/unshare --mount --propagation private -- /storage/.local/share/rocknix-xfce/bin/launch-xfce
ExecStopPost=/storage/.local/share/rocknix-xfce/bin/restore-emulationstation
KillMode=control-group
TimeoutStopSec=20
Restart=no
StandardOutput=journal
StandardError=journal
