[Unit]
Description=ROCKNIX Sway Desktop Mode
Documentation=file:/storage/.local/share/rocknix-xfce/README.md
BindsTo=sway.service
After=network.target sway.service
ConditionPathIsDirectory=/storage/.local/share/rocknix-xfce/rootfs

[Service]
Type=simple
Environment=HOME=/storage
ExecStartPre=/storage/.local/share/rocknix-xfce/bin/preflight
ExecStart=/usr/bin/unshare --mount --propagation private -- /storage/.local/share/rocknix-xfce/bin/launch-sway-desktop
ExecStopPost=/storage/.local/share/rocknix-xfce/bin/restore-emulationstation
KillMode=control-group
TimeoutStopSec=45
Restart=no
StandardOutput=journal
StandardError=journal
